            <value>msc/alert/environment/hazard/alert-3.0-ascii/consolidated-xml-2.0/20260709024832464/AB_00_01_LAND/TRW/122432711689869527202607090501_AB_00_01_LAND/actual/en_proper_complete_c-fr_proper_complete_c/NinJo</value>
        </parameter>
        <parameter>
            <valueName>layer:EC-MSC-SMC:1.1:CAP_count</valueName>
            <value>A:20426 M:105289 C:120563</value>
        </parameter>
        <parameter>
