            <value>msc/alert/environment/hazard/alert-3.0-ascii/consolidated-xml-2.0/20260706033230679/MB_00_01_LAND/TRW/323016601229944013202607060501_MB_00_01_LAND/actual/en_proper_complete_c-fr_proper_complete_c/NinJo</value>
        </parameter>
